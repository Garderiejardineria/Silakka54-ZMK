#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

// Layout pensado para macOS con fuente de entrada "Español - ISO".
// ñ = SEMI, ´ (acentos) = SQT, símbolos AltGr en la capa 1, BT/Studio en la capa 2.

/ {
    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            bindings = <
&kp ESC    &kp N1     &kp N2    &kp N3    &kp N4    &kp N5              &kp N6    &kp N7    &kp N8     &kp N9    &kp N0     &kp BSPC
&kp TAB    &kp Q      &kp W     &kp E     &kp R     &kp T               &kp Y     &kp U     &kp I      &kp O     &kp P      &kp LBKT
&kp LCTRL  &kp A      &kp S     &kp D     &kp F     &kp G               &kp H     &kp J     &kp K      &kp L     &kp SEMI   &kp SQT
&kp LSHFT  &kp Z      &kp X     &kp C     &kp V     &kp B   &none &none  &kp N     &kp M     &kp COMMA  &kp DOT   &kp SLASH  &kp RSHFT
                                &kp LGUI  &kp LALT  &mo 1   &none &none  &mo 2     &kp SPACE  &kp RET
            >;
        };

        sym_layer {
            display-name = "Simb";
            bindings = <
&trans  &kp F1        &kp F2        &kp F3        &kp F4        &kp F5                  &kp F6     &kp F7     &kp F8     &kp F9     &kp F10        &kp DEL
&trans  &kp RA(N1)    &kp RA(N2)    &kp RA(N3)    &kp RA(N4)    &kp RA(E)               &kp RA(LBKT) &kp RA(RBKT) &kp RA(SQT) &kp RA(NON_US_HASH) &kp RA(GRAVE) &kp F11
&trans  &kp EQUAL     &kp LS(EQUAL) &kp NON_US_BSLH &kp MINUS  &kp GRAVE               &kp LEFT   &kp DOWN   &kp UP     &kp RIGHT  &kp NON_US_HASH &kp F12
&trans  &trans        &trans        &trans        &trans       &trans  &none &none      &kp HOME   &kp PG_DN  &kp PG_UP  &kp END    &trans         &trans
                                    &trans        &trans       &trans  &none &none      &trans     &trans     &trans
            >;
        };

        fn_layer {
            display-name = "Fn";
            bindings = <
&trans       &kp C_BRI_DN   &kp C_BRI_UP   &trans        &trans        &trans                &kp C_PREV  &kp C_PP    &kp C_NEXT  &kp C_MUTE  &kp C_VOL_DN  &kp C_VOL_UP
&trans       &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4          &trans      &trans      &trans      &trans      &trans        &bt BT_CLR
&trans       &out OUT_USB   &out OUT_BLE   &trans        &trans        &studio_unlock        &trans      &trans      &trans      &trans      &trans        &trans
&bootloader  &sys_reset     &trans         &trans        &trans        &trans  &none &none    &trans      &trans      &trans      &trans      &sys_reset    &bootloader
                                           &trans        &trans        &trans  &none &none    &trans      &trans      &trans
            >;
        };
    };
};
